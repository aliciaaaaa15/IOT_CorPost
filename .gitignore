# ---------------------------------------------------------------
# CorPost repository root
# (each project -HW/corpost_fw, HW/ai_movment_test, SW/backend,
#  SW/frontend- also has its own .gitignore)
# ---------------------------------------------------------------

# Office temporary files (they appear while a document is open)
~$*
*.tmp
*.bak
*.swp

# Secrets
.env
.env.*
!.env.example
*.pem
*.key

# Logs
*.log

# Editor / system
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
