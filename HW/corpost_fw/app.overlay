/* I2C bus settings for the BNO055 (long cables, unknown pull-ups).
 * 1) Use the TWIM peripheral with EasyDMA instead of the board's CPU-driven TWI.
 * 2) Force 100 kHz.
 * 3) Enable the internal SDA/SCL pull-ups (~13 kΩ; they help, but do not replace external 4.7 kΩ ones). */
&i2c0 {
	compatible = "nordic,nrf-twim";
	clock-frequency = <I2C_BITRATE_STANDARD>;
};

&i2c0_default {
	group1 {
		bias-pull-up;
	};
};
