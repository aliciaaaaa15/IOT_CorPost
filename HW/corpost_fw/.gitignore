# ---------------------------------------------------------------
# Firmware (nRF Connect SDK / Zephyr)
# ---------------------------------------------------------------
# Build folders (generated by the nRF Connect extension or `west build`)
build/
build_*/
_sysbuild/
.cache/

# Binaries and build outputs
*.hex
*.elf
*.bin
*.map
*.uf2
compile_commands.json

# Debug logs (J-Link / RTT)
*.log
JLink*.txt
rtt*.txt

# Editor / system (the nRF Connect configuration is local to each machine)
.vscode/
.idea/
.DS_Store
Thumbs.db

# Secrets and local files
.env
.env.*
!.env.example
